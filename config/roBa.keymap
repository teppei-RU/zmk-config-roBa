#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        hankaku: to_layer_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LALT>;

            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&hankaku>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q           &kp W    &kp E     &kp R              &kp T                                                      &kp Y                    &kp U  &kp I      &kp O      &kp BACKSPACE
&kp A           &kp S    &kp D     &kp F              &kp G                  &lt 2 UNDERSCORE      &lt 3 DOLLAR  &kp H                    &kp K  &mkp LCLK  &kp MINUS  &kp RIGHT_SHIFT
&kp Z           &kp X    &kp C     &kp V              &kp B                  &kp N                 &kp M         &kp A                    &kp J  &kp L      &kp P      &kp PERIOD
&kp DOWN_ARROW  &kp TAB  &hankaku  &kp RIGHT_CONTROL  &lt 1 INTERNATIONAL_4  &lt 2 LEFT_SHIFT      &lt 3 SPACE   &mt RIGHT_CONTROL ENTER                               &kp UP_ARROW
            >;
        };

        NUM {
            bindings = <
&kp NUMBER_1                &kp N2           &kp NUMBER_3     &kp NUMBER_4     &kp N5                                             &kp CARET             &kp COMMA              &kp COMMA  &kp PERIOD  &kp DELETE
&kp NUMBER_6                &kp N7           &kp N8           &kp N9           &kp N0      &kp LC(LA(EQUAL))      &kp UNDERSCORE  &kp EXCLAMATION       &kp COMMA              &kp COMMA  &kp PERIOD  &kp PERCENT
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD  &kp EQUAL              &trans          &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDER  &kp MINUS   &kp BACKSLASH
&trans                      &trans           &trans           &trans           &trans      &trans                 &mkp MB4        &mkp MB5                                                            &kp PIPE
            >;

            sensor-bindings =
                <&inc_dec_kp 0 0>,
                <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                        &trans    &trans    &kp UP_ARROW  &mkp MB3       &mkp MB2
&trans  &trans  &trans  &trans  &trans  &trans      &trans    &trans    &mkp MB1  &mkp MB1      &mkp MB3       &mkp MB2
&trans  &trans  &trans  &trans  &trans  &trans      &trans    &trans    &trans    &kp DOWN      &kp PAGE_DOWN  &kp DOWN
&trans  &trans  &trans  &trans  &trans  &trans      &mkp MB4  &mkp MB5                                         &trans
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(F1))          &kp F2          &kp LC(F3)               &kp F4                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp UP_ARROW    &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };
    };
};
